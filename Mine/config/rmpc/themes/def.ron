#![enable(implicit_some)]
#![enable(unwrap_newtypes)]
#![enable(unwrap_variant_newtypes)]
(
    draw_borders: false,
    show_song_table_header: true,
    background_color: "#2D353B",
    default_album_art_path: None,
    header_background_color: None,
    modal_background_color: None,
    modal_backdrop: true,
    format_tag_separator: " | ",
    multiple_tag_resolution_strategy: Last,
    text_color: None,
    preview_label_style: (fg: "#DBBC7F"),
    preview_metadata_group_style: (fg: "#DBBC7F", modifiers: "Bold"),
    level_styles: (
        info: (fg: "#7FBBB3", bg: "#2D353B"),
        warn: (fg: "#DBBC7F", bg: "#2D353B"),
        error: (fg: "#E67E80", bg: "#2D353B"),
        debug: (fg: "#83C092", bg: "#2D353B"),
        trace: (fg: "#D699B6", bg: "#2D353B"),
    ),
    cava: (
        bar_width: 2,
        bar_spacing: 1,
        orientation: Bottom,
        bar_color: Gradient({
              0: "#7FBBB3", 
             14: "#83C092", 
             28: "#A7C080", 
             42: "#DBBC7F", 
             56: "#E69875", 
             70: "#E67E80", 
             84: "#E67E80",
            100: "#D699B6",
        }),
    ),
    lyrics: (
        timestamp: false,
    ),
    components: {
        "state": Pane(Property(
            content: [
                (kind: Text("["), style: (fg: "#DBBC7F", modifiers: "Bold")),
                (kind: Property(Status(StateV2())), style: (fg: "#DBBC7F", modifiers: "Bold")),
                (kind: Text("] "), style: (fg: "#DBBC7F", modifiers: "Bold")),
            ], align: Left,
        )),
        "title": Pane(Property(
            content: [
                (kind: Property(Song(Title)), style: (modifiers: "Bold"),
                    default: (kind: Text("No Song"), style: (modifiers: "Bold"))),
            ], align: Center, scroll_speed: 1
        )),
        "volume": Split(
            direction: Horizontal,
            panes: [
                (size: "100%", pane: Pane(Property(content: [(kind: Property(Widget(Volume)), style: (fg: "#7FBBB3"))], align: Right))),
                (size: "3", pane: Pane(Property(content: [(kind: Property(Status(Volume)), style: (fg: "#7FBBB3"))], align: Right))),
                (size: "1", pane: Pane(Property(content: [(kind: Text("%"), style: (fg: "#7FBBB3"))]))),
            ]
        ),
        "elapsed_and_bitrate": Pane(Property(
            content: [
                (kind: Property(Status(Elapsed))), 
                (kind: Text(" / ")), 
                (kind: Property(Status(Duration))), 
                (kind: Group([
                    (kind: Text(" (")), 
                    (kind: Property(Status(Bitrate))), 
                    (kind: Text(" kbps)")),
                ])),
            ],
            align: Left,
        )),
        "artist_album": Pane(Property(
            content: [
                (kind: Property(Song(Artist)), style: (fg: "#DBBC7F", modifiers: "Bold"),
                    default: (kind: Text("Unknown"), style: (fg: "#DBBC7F", modifiers: "Bold"))),
                (kind: Text(" - ")),
                (kind: Property(Song(Album)), default: (kind: Text("Unknown Album")))
            ], align: Center, scroll_speed: 2
        )),
        "states": Pane(Property(
            content: [
                (kind: Property(Status(RepeatV2(
                    on_label: " ",
                    off_label: " ",
                    on_style: (fg: "#DBBC7F", modifiers: "Bold"),
                    off_style: (fg: "#7FBBB3", modifiers: "Dim"),
                )))),
                (kind: Property(Status(RandomV2(
                    on_label: " ",
                    off_label: " ",
                    on_style: (fg: "#DBBC7F", modifiers: "Bold"),
                    off_style: (fg: "#7FBBB3", modifiers: "Dim"),
                )))),
                (kind: Property(Status(SingleV2(
                    on_label: "󰑘 ",
                    off_label: "󰑘 ",
                    oneshot_label: "󰑘 ",
                    on_style: (fg: "#E67E80", modifiers: "Bold"),
                    off_style: (fg: "#7FBBB3", modifiers: "Dim"),
                    oneshot_style: (fg: "#DBBC7F", modifiers: "Bold"),
                )))),
                (kind: Property(Status(ConsumeV2(
                    on_label: " ",
                    off_label: " ",
                    oneshot_label: " ",
                    on_style: (fg: "#E67E80", modifiers: "Bold"),
                    off_style: (fg: "#7FBBB3", modifiers: "Dim"),
                    oneshot_style: (fg: "#DBBC7F", modifiers: "Dim"),
                )))),
                (kind: Text(" / "), style: (fg: "#7FBBB3")), 
                (kind: Property(Status(QueueTimeRemaining(separator: " "))), style: (fg: "#7FBBB3", modifiers: "Bold")),
            ], align: Right
        )),
        "top_row": Split(
            direction: Horizontal,
            panes: [
                (size: "23", pane: Component("state")),
                (size: "100%", borders: "LEFT | RIGHT", pane: Component("title")),
                (size: "23", pane: Component("volume")),
            ],
        ),
        "bottom_row": Split(
            direction: Horizontal,
            panes: [
                (
                    size: "23",
                    pane: Component("elapsed_and_bitrate"),
                ),
                (
                    size: "100%",
                    borders: "LEFT | RIGHT",
                    pane: Component("artist_album"),
                ),
                (
                    size: "23",
                    pane: Component("states"),
                ),
            ],
        ),
        "header": Split(
            direction: Vertical,
            panes: [
                (
                    size: "1",
                    direction: Vertical,
                    pane: Component("top_row"),
                ),
                (
                    size: "1",
                    direction: Vertical,
                    pane: Component("bottom_row"),
                ),
            ] 
        ),
        "progress_bar": Split(
            direction: Horizontal,
            panes: [
                (
                    pane: Pane(Property(content: [(kind: Property(Status(StateV2(playing_label: "  ", paused_label: "  ", stopped_label: "  ",
                        playing_style: (fg: "#A7C080"), paused_style: (fg: "#E69875"), stopped_style: (fg: "#E67E80")
                    ))))], align: Left)),
                    size: "3",
                ),
                (
                    size: "100%",
                    pane: Pane(ProgressBar),
                ),
                (
                    size: "13",
                    pane: Pane(Property(
                        content: [
                            (kind: Property(Status(Elapsed))),
                            (kind: Text(" / ")),
                            (kind: Property(Status(Duration))),
                        ], align: Right,
                    )),
                ),
            ]
        ),
    },
    layout: Split(
        direction: Vertical,
        panes: [
            (
                size: "4",
                borders: "ALL",
                pane: Component("header"),
            ),
            (
                size: "3",
                borders: "ALL",
                pane: Pane(Tabs),
            ),
            (
                size: "100%",
                borders: "ALL",
                pane: Pane(TabContent),
            ),
            (
                size: "3",
                borders: "ALL",
                pane: Component("progress_bar"),
            ),
        ]
    ),
    symbols: (
        song: " ",
        dir: " ",
        playlist: "󰲸 ",
        marker: "\u{e0b0}",
        ellipsis: "…",
        song_style: None,
        dir_style: None,
    ),
    progress_bar: (
        symbols: ["", "█", "", "█", "" ],
        track_style: (fg: "#3D484D"),
        elapsed_style: (fg: "#A7C080"),
        thumb_style: (fg: "#A7C080", bg: "#3D484D"),
    ),
    scrollbar: (
        symbols: ["│", "█", "▲", "▼"],
        track_style: (),
        ends_style: (),
        thumb_style: (fg: "#7FBBB3"),
    ),
    browser_column_widths: [20, 38, 42],
    browser_song_format: [
        (
            kind: Group([
                (kind: Property(Track)),
                (kind: Text(" - ")),
            ]),
        ),
        (
            kind: Property(Other("name")),
            default: (
                kind: Group([
                    (kind: Property(Artist)),
                    (kind: Text(" - ")),
                    (kind: Property(Title)),
                ]),
                default: (kind: Property(Filename))
            ),
        ),
        (
            kind: Text(" Rating: "),
        ),
        (
            kind: Sticker("rating"),
            default: (kind: Text("-"))
        ),
    ],
    tab_bar: (
        active_style: (fg: "#2D353B", bg: "#A7C080", modifiers: "Bold"),
        inactive_style: (),
    ),
    highlighted_item_style: (fg: "#D3C6AA", bg: "#3D484D", modifiers: "Bold"),
    current_item_style: (fg: "#2D353B", bg: "#A7C080", modifiers: "Bold"),
    borders_style: (fg: "#7A8478"),
    highlight_border_style: (fg: "#DBBC7F"),
    song_table_album_separator: None,
    song_table_format: [
        (
            prop: (kind: Property(Position)),
            width: "5",
            alignment: Right,
            label: ""
        ),
        (
            prop: (
                kind: Property(Title),
                default: (kind: Text("Unknown"))
            ),
            width: "80%",
            label: "Title"
        ),
        (
            prop: (
                kind: Property(Artist),
                default: (kind: Text("Unknown"))
            ),
            width: "20%",
            label: "Artist"
        ),
        (
            prop: (
                kind: Property(Duration),
                default: (kind: Text("-"))
            ),
            width: "8",
            alignment: Right,
            label: "Len"
        ),
    ],
//    song_table_format: [
//        (
//            prop: (kind: Property(Position)),
//            width: "2",
//            alignment: Right,
//            label: ""
//        ),
//        (
//            prop: (kind: Property(Other("albumartist")), default: (kind: Property(Artist), default: (kind: Text("Unknown")))),
//            width: "20%",
//            label: "Artist"
//        ),
//        (
//            prop: (kind: Property(Title), default: (kind: Text("Unknown"))),
//            width: "35%",
//        ),
//        (
//            prop: (kind: Property(Album), default: (kind: Text("Unknown Album"))),
//            width: "45%",
//        ),
//        (
//            prop: (kind: Property(Duration),default: (kind: Text("-"))),
//            width: "5",
//            alignment: Right,
//            label: "Len"
//        ),
//    ],
    header: (rows: []),
)
