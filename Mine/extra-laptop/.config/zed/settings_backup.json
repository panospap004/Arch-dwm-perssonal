// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run the `open default settings` command
// from the command palette or from `Zed` application menu.
{
  "assistant": {
    "default_model": {
      "provider": "ollama",
      "model": "llama3:8b-instruct-q8_0"
    },
    "version": "2"
  },
  "collaboration_panel": {
    "dock": "right"
  },
  "outline_panel": {
    "dock": "right"
  },
  "project_panel": {
    "dock": "right"
  },
  //"buffer_font_family": "FantasqueSansM Nerd Font",
  //"ui_font_family": "FantasqueSansM Nerd Font",
  "buffer_font_family": "MonaspiceRn Nerd Font",
  "ui_font_family": "MonaspiceRn Nerd Font",
  "ui_font_size": 17.5,
  "buffer_font_size": 17.5,
  "buffer_font_features": {
    "calt": true,
    "ss01": true,
    "ss02": true,
    "ss03": true,
    "ss04": true,
    "ss05": true,
    "ss06": true,
    "ss07": true,
    "ss08": true,
    "ss09": true,
    "liga": true
  },
  "ui_font_features": {
    "calt": true,
    "ss01": true,
    "ss02": true,
    "ss03": true,
    "ss04": true,
    "ss05": true,
    "ss06": true,
    "ss07": true,
    "ss08": true,
    "ss09": true,
    "liga": true
  },
  "theme": "Gruvbox Dark Soft",
  // my settings
  "current_line_highlight": "gutter",
  "scrollbar": {
    "show": "never" // maebe auto
  },

  "line_numbers": {
    "show": true,
    "style": ""
  },

  "git_statues": {
    "show": true
  },

  "always_treat_brackets_as_autoclosed": true,

  "inlay_hints": {
    "enabled": true,
    "type_hints": true,
    "parameter_hints": true,
    "chaining_hints": true,
    "max_length": 80
  },

  "tabs": {
    "show": true,
    "size": 2,
    "style": "soft"
  },

  "dock": {
    "open": "right"
  },

  "vim_mode": true,
  "relative_line_numbers": true
}
